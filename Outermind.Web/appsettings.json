{
  "AllowedHosts": "*",
  "serilog": {
    "minimumLevel": {
      "default": "Debug",
      "override": {
        "EventStore.Client": "Warning",
        "Grpc.Net.Client": "Warning"
      }
    }
  },
  "totem.timeline.eventStore": {
    "verbose": true,
    "server": {
      "name": "localhost",
      "port": 2113,
      "insecure": true
    },
    "connection": {
      "username": "admin",
      "password": "changeit",
      "timeout": "00:15:00"
    },
    "projections": {
      "installTimeout": "00:00:05"
    }
  },
  "InteractionIdentity": {
    "unidentifiedDisplayLabel": "Unidentified user",
    "trackingSourceWhenPrincipalPresent": "windows-integrated-auth",
    "accountMappings": []
  },
  "InteractionAuth": {
    "userStorePath": "App_Data\\interaction-users.json",
    "cookieName": "Totem.Auth",
    "cookieLifetimeHours": 8,
    "slidingExpiration": true,
    "requireSecureCookies": false,
    "sameSite": "Lax",
    "csrf": {
      "cookieName": "Totem.Csrf",
      "headerName": "X-CSRF-TOKEN"
    }
  },
  "ScanProcessingDemo": {
    "enabled": false,
    "allowSyntheticActor": false,
    "transitionDelayMilliseconds": 750,
    "planLifetimeMinutes": 30
  }
}
